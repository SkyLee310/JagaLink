# Copy to backend/.env for local overrides; the defaults below match docker-compose.yml.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://jagalink:jagalink@localhost:5432/jagalink
FRONTEND_ORIGIN=http://localhost:5173
# In prod: a random string of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-session-secret
