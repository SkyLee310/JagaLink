{
  "openapi": "3.1.0",
  "info": {
    "title": "JagaLink API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness for Railway: 200 when the database answers, 503 when it does not.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/users": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "List Session Users",
        "description": "Seeded users for the role picker. No token: there is no real login (D-28).",
        "operationId": "list_session_users_api_v1_session_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionUserOut"
                  },
                  "type": "array",
                  "title": "Response List Session Users Api V1 Session Users Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Create Session",
        "description": "Pick a seeded user. Send the token back as `Authorization: Bearer <token>` (D-41).",
        "operationId": "create_session_api_v1_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/communities/{community_id}/layout": {
      "get": {
        "tags": [
          "layout"
        ],
        "summary": "Get Layout",
        "description": "Zones, nodes and links of one community in a single response (F1).",
        "operationId": "get_layout_api_v1_communities__community_id__layout_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "community_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Community Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayoutOut"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommunityOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "map_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Map Image Url"
          },
          "scale_m_per_px": {
            "type": "number",
            "title": "Scale M Per Px"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "map_image_url",
          "scale_m_per_px",
          "timezone"
        ],
        "title": "CommunityOut"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "description": "The one error body (D-40)."
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "title": "Db"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db"
        ],
        "title": "HealthOut"
      },
      "LayoutOut": {
        "properties": {
          "community": {
            "$ref": "#/components/schemas/CommunityOut"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/ZoneOut"
            },
            "type": "array",
            "title": "Zones"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NodeOut"
            },
            "type": "array",
            "title": "Nodes"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkOut"
            },
            "type": "array",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "community",
          "zones",
          "nodes",
          "links"
        ],
        "title": "LayoutOut"
      },
      "LinkOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "from_node_id": {
            "type": "string",
            "format": "uuid",
            "title": "From Node Id"
          },
          "to_node_id": {
            "type": "string",
            "format": "uuid",
            "title": "To Node Id"
          },
          "travel_min_s": {
            "type": "integer",
            "title": "Travel Min S"
          },
          "travel_max_s": {
            "type": "integer",
            "title": "Travel Max S"
          },
          "bidirectional": {
            "type": "boolean",
            "title": "Bidirectional"
          }
        },
        "type": "object",
        "required": [
          "id",
          "from_node_id",
          "to_node_id",
          "travel_min_s",
          "travel_max_s",
          "bidirectional"
        ],
        "title": "LinkOut"
      },
      "NodeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "kind": {
            "type": "string",
            "enum": [
              "camera",
              "sensor"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "heading_deg": {
            "type": "number",
            "title": "Heading Deg"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ],
            "title": "Status"
          },
          "zone_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "kind",
          "name",
          "x",
          "y",
          "heading_deg",
          "status",
          "zone_id"
        ],
        "title": "NodeOut"
      },
      "SessionIn": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "SessionIn"
      },
      "SessionOut": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserOut"
          },
          "community_id": {
            "type": "string",
            "format": "uuid",
            "title": "Community Id"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "user",
          "community_id"
        ],
        "title": "SessionOut"
      },
      "SessionUserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "guard",
              "supervisor"
            ],
            "title": "Role"
          },
          "on_duty": {
            "type": "boolean",
            "title": "On Duty"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "role",
          "on_duty"
        ],
        "title": "SessionUserOut"
      },
      "ZoneOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "street",
              "gate",
              "lane"
            ],
            "title": "Kind"
          },
          "polygon": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Polygon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "kind",
          "polygon"
        ],
        "title": "ZoneOut"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "The token from POST /api/v1/session",
        "scheme": "bearer"
      }
    }
  }
}
