# Copy to backend/.env for local overrides; the defaults below match docker-compose.yml.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://jagalink:jagalink@localhost:5432/jagalink
FRONTEND_ORIGIN=http://localhost:5173
# In prod: a random string of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-session-secret
# Seconds a track lives after its last sighting (D-56); shorten it to show expiry in a demo.
TRACK_TTL_S=86400
# Next-camera score weights (D-57), as JSON.
NEXT_CAMERA_WEIGHTS={"direction": 1.0, "backtrack": 2.0, "walk": 0.5, "route_share": 1.0}
# Severity of every alert on a track once two or more rules match it (D-60).
MULTI_RULE_SEVERITY=high
